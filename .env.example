# PostgreSQL Persistence (Aiven PostgreSQL URI; sslmode=require is enforced automatically)
DATABASE_URL=postgres://avnadmin:replace-with-aiven-password@your-service.aivencloud.com:12345/defaultdb?sslmode=require

# Backend Auth & Security (at least 32 bytes for HS256)
JWT_SECRET_KEY=replace-with-32-plus-byte-random-secret-key-in-production

# CORS Allowed Frontend Origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173

# Streaming & Feature Store Mode: embedded_replay | kafka | live
INGESTION_MODE=live
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=influencer.engagement.events

# Live YouTube & YouTube Shorts Data API v3 Integration
YOUTUBE_API_KEY=

# Frontend API Target (set to your Render backend URL in Vercel)
VITE_API_BASE_URL=http://localhost:8000
