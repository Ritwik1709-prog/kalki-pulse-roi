# Backend Auth & Security
JWT_SECRET_KEY=replace-with-32-plus-byte-random-secret-key-in-production

# Streaming & Feature Store Mode: embedded_replay | kafka | live
INGESTION_MODE=live
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=influencer.engagement.events

# Live YouTube & YouTube Shorts Data API v3 Integration
YOUTUBE_API_KEY=

# Frontend API Target
VITE_API_BASE_URL=http://localhost:8000
